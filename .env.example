# Database (SQLite for local dev or PostgreSQL URL for Neon / Supabase / Railway)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@ep-cool-db.us-east-2.aws.neon.tech/linkguard?sslmode=require"

# App & Auth Secrets
PORT=3001
NEXTAUTH_URL="http://localhost:5173"
NEXTAUTH_SECRET="linkguard_super_secure_jwt_secret_key_change_in_production"

# Google OAuth (Optional for Google Sign In)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Telegram Bot Alerts (Get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="@LinkGuardAlertsBot"

# Email Alerts (Resend or SMTP)
RESEND_API_KEY=""
EMAIL_FROM="LinkGuard Alerts <alerts@linkguard.io>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Cron Protection Secret
CRON_SECRET="linkguard_cron_secret_auth_token_2026"

# Stripe Payments (Optional for billing subscriptions)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO="price_pro_monthly"
STRIPE_PRICE_BUSINESS="price_business_monthly"
